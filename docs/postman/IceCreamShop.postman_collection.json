              "raw": "{{baseUrl}}/items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "items"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_id\": 1,\n  \"name\": \"Chocolate Brownie Tub (1L)\",\n  \"sku\": \"CHO-BRW-1L\",\n  \"description\": \"Chocolate ice cream with brownie chunks.\",\n  \"price\": 10.49,\n  \"quantity\": 20,\n  \"reorder_level\": 8\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.collectionVariables.set('itemId', pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
